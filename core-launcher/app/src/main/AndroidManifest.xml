<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WebView navigation requires INTERNET even for loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- System status indicators surfaced to the panel via window.WavrNative. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- LAN service advertisement (mDNS / DNS-SD via NsdManager) so Wavr Mobile
         companions can auto-discover this Core as _wavr._tcp on port 8000. Some
         devices only deliver/announce multicast mDNS while a WifiManager
         MulticastLock is held; acquiring that lock needs this permission. No
         data leaves the LAN — only the service name + tiny TXT (v/role/path). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Bluetooth on/off read. BLUETOOTH_CONNECT (API 31+) is declared but NOT
         requested at runtime: reading adapter state does not require it, and a
         kiosk simply reports bt:false rather than prompting. Legacy BLUETOOTH
         covers API 26-30.
         NOTE: BLUETOOTH_SCAN and ACCESS_FINE_LOCATION are deliberately ABSENT.
         See BlePermissions.kt — Wavr's BLE source infers which ROOM someone is
         in from RSSI, which is location derivation, so `neverForLocation` would
         be a false claim and FINE_LOCATION would be the honest requirement.
         Declaring a location permission for a scanner that does not exist yet is
         worse than the prompt it would avoid, so both land with the scanner or
         not at all. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Biometric unlock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- On-device camera as a local MJPEG source (loopback only). Requested at
         runtime the first time WavrNative.setCamera(true) is called; the stream
         defaults OFF and the camera device is closed until then. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A camera is not required to run the kiosk (feature is opt-in). -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- ==================================================================
         Core runtime (ADR-0010). Everything below exists so this device can
         HOST a Wavr Core rather than only render one. All of it is inert until
         the operator gives the device the `core` function: an unconfigured
         install starts no service, schedules no job, and shows no notification.
         ================================================================== -->

    <!-- The Core's supervisor process. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: `specialUse` is the honest type for "runs the user's own local
         server on their own device". `dataSync` (used on API 29..33, where
         specialUse does not exist) is wrong on 34+ and, since Android 15, capped
         at six hours a day — which would kill a house brain every afternoon. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:targetApi="34" />
    <!-- Asserted only while the camera source is actually streaming. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA"
        tools:targetApi="34" />

    <!-- The notification is this app's honesty surface: what is running, why,
         and a one-tap Stop. Without this grant on API 33+ the service still runs
         but the notice is hidden from the shade, so it is requested — with an
         explanation — when the device becomes a Core. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Bring the Core back after a reboot, if and only if the operator enabled
         autostart and has not pressed Stop. Also lets the watchdog job persist. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Doze exemption. NEVER requested silently: PowerPolicy shows the reason
         first, the default route is Android's own settings list (which needs no
         permission at all), and the Core keeps running — degraded and saying so
         — if the answer is no. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WavrCore"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleInstance"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density|navigation"
            android:theme="@style/Theme.WavrCore">

            <!-- Registered as a HOME launcher so the device can boot straight into it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reference experience #5: an Android application reading Wavr through
             the Spatial SDK (dev.wavr.sdk).

             NOT exported and deliberately absent from the launcher. The product
             on this phone is the Core and its kiosk panel; a second icon in a
             household's app drawer would be platform complexity leaking into the
             ordinary setup, which is exactly what Developer Mode exists to keep
             out of the way. On a debuggable build:

               adb shell am start -n dev.wavr.core/dev.wavr.sdk.SpatialDemoActivity
        -->
        <activity
            android:name="dev.wavr.sdk.SpatialDemoActivity"
            android:exported="false"
            android:label="Wavr Spatial Demo"
            android:theme="@style/Theme.WavrCore" />

        <!-- The embedded Core. Not exported: nothing outside this app may start,
             stop, or bind it. The declared type UNION is what the platform
             permits; CoreService.foregroundServiceType() asserts only the subset
             actually in use at any moment, so `camera` is never claimed while the
             camera is closed. -->
        <service
            android:name=".CoreService"
            android:exported="false"
            android:directBootAware="false"
            android:foregroundServiceType="dataSync|camera|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the user's own Wavr Core: a local home-sensing server on this device, reachable only on loopback unless the operator explicitly enables their own LAN." />
        </service>

        <!-- Periodic watchdog: restarts the Core if the process died and nothing
             asked for it back. JobScheduler's 15-minute floor is accepted rather
             than fought (see CoreWatchdogJob) — the alternative is a permanent
             wake lock, which is exactly what this design refuses. -->
        <service
            android:name=".CoreWatchdogJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Reboot / app-update recovery. Three gates in onReceive, all of which
             must pass, so installing this APK never changes what the phone does
             on boot until the operator asks for a Core. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
