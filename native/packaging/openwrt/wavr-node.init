#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/wavr
STATE_DIR=/overlay/wavr-node
SENSOR=ld2450:/dev/ttyUSB0

start_service() {
    [ -x "$PROG" ] || return 1
    [ -d /overlay ] || return 1
    mkdir -p "$STATE_DIR" || return 1
    chmod 700 "$STATE_DIR"
    procd_open_instance
    procd_set_param command "$PROG" node run --sensor "$SENSOR" --state "$STATE_DIR/node.json"
    procd_set_param stdout 1
    procd_set_param stderr 1
    # No automatic respawn: revoked exits 3 and must stay stopped.
    procd_close_instance
}
